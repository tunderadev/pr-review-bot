# Copy to ~/.config/pr-review-bot/.env — never commit a filled-in copy.
#
# These four are required. The CLI reads this file first, then lets anything
# already exported in the shell win, so an export is always a deliberate
# override. All four must be non-empty or the run stops before it touches
# GitHub, naming the ones that are missing.

# GitHub App → Settings → the "App ID" field.
GITHUB_APP_ID=123456

# Path to the .pem downloaded from the App's settings page. A path, never the
# key itself: the file is read and checked for a PEM private key header, and
# its contents are deliberately never echoed.
GITHUB_APP_PRIVATE_KEY_PATH=/Users/you/.config/pr-review-bot/app-private-key.pem

# The installation, not the App. Visible in the URL when you open the App's
# "Configure" page for your org: .../settings/installations/<this number>
GITHUB_APP_INSTALLATION_ID=987654

# Slack bot token (starts xoxb-), from the Slack app's OAuth page. The pipeline
# uses exactly two scopes: chat:write to announce and thread-reply, and
# reactions:write to add AND remove the state reaction. The bot must also be
# invited to the review channel. (An unmapped author degrades to unlinked text
# — map them in authorMap; nothing in the cycle looks a login up by email.)
SLACK_BOT_TOKEN=xoxb-your-bot-token

# ---------------------------------------------------------------------------
# NOT read from this file — export these in the shell instead
# ---------------------------------------------------------------------------
#
# PR_REVIEW_CONFIG_DIR   Which team profile to run. It is read from the process
#                        environment only, so setting it here does nothing at
#                        all: the run falls through to ./.claude/pr-review and
#                        then ~/.config/pr-review-bot/default and reports "No
#                        team.json found". Export it, or pass --config <dir>.
#
# PR_REVIEW_DEBUG=1      Print a stack trace on an internal failure (exit 5).
#                        Also process-environment only.
#
# ANTHROPIC_API_KEY, ANTHROPIC_AUTH_TOKEN, ANTHROPIC_BASE_URL,
# CLAUDE_CODE_USE_BEDROCK, CLAUDE_CODE_USE_VERTEX
#                        Do not set any of these anywhere near the loop. Each
#                        one takes headless reviews off your Claude
#                        subscription and meters them somewhere else, on a
#                        process that polls forever. `doctor` reports them as a
#                        red "claude auth mode" check.
